# Local placeholders only. Copy to .env; never commit real credentials.
# Database-backed authentication requires a migrated development database.

# Runtime PostgreSQL connection through your provider's pooler.
DATABASE_URL="postgresql://civicspec:local-only@localhost:5432/civicspec?pgbouncer=true"
# Unpooled PostgreSQL connection used by Prisma migration tooling.
DIRECT_URL="postgresql://civicspec:local-only@localhost:5432/civicspec"

APP_URL="http://localhost:3000"
# Required when auth is used: generate a unique random secret (32+ bytes).
# Public-only builds may leave this empty; auth operations fail closed without it.
AUTH_SECRET=""

GITHUB_GOVERNANCE_MODE="FREE_FORK_CI"
# Optional, inactive GitHub App / OAuth configuration.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GITHUB_ORG="civicspec-org"

# Optional, inactive AI gateway configuration. No provider is enabled by default.
AI_PROVIDER="disabled"
AI_MODEL=""
AI_MAX_CONTEXT_TOKENS="32000"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
